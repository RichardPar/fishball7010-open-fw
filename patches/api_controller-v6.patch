+# --- fork-light helpers (CPU optimisation) -------------------------------------------------
+# read_file_v: like read_file but returns the value in $RF without a subshell.
+read_file_v () {
+  if [ -r "$1" ]; then
+    RF=""
+    IFS= read -r -d '' RF < "$1" 2>/dev/null
+    RF=${RF%$'\n'}
+  else
+    RF='n/a'
+  fi
+}
+
+# fwenv_get: U-Boot environment value in $FWV, cached; fw_printenv reads the QSPI flash, so refresh at most
+# every FWENV_MAX dump cycles per variable.
+declare -A FWENV FWENV_AGE
+FWENV_MAX=15
+fwenv_get () {
+  local _n="$1"
+  if [ "${FWENV_AGE[$_n]:-$FWENV_MAX}" -ge "$FWENV_MAX" ]; then
+    FWENV[$_n]=$(fw_printenv -n "$_n" 2>/dev/null)
+    FWENV_AGE[$_n]=0
+  else
+    FWENV_AGE[$_n]=$(( FWENV_AGE[$_n] + 1 ))
+  fi
+  FWV=${FWENV[$_n]}
+}
+
+# reg_rd / reg_wr: IIO direct register access through debugfs (what iio_attr -D does), without starting
+# a libiio context. Falls back to iio_attr if the debugfs file is not writable.
+reg_rd () {  # $1 iio device dir, $2 register, $3 device name for the fallback
+  local _d=${1%/} _f
+  _f="/sys/kernel/debug/iio/${_d##*/}/direct_reg_access"
+  REGV=""
+  if [ -w "$_f" ]; then
+    { echo "$2" > "$_f"; } 2>/dev/null && read -r REGV < "$_f" 2>/dev/null && return 0
+  fi
+  REGV=$(iio_attr -D "$3" direct_reg_access "$2" 2>/dev/null)
+}
+reg_wr () {  # $1 iio device dir, $2 "register value", $3 device name for the fallback
+  local _d=${1%/} _f
+  _f="/sys/kernel/debug/iio/${_d##*/}/direct_reg_access"
+  if [ -w "$_f" ]; then
+    { echo "$2" > "$_f"; } 2>/dev/null && return 0
+  fi
+  iio_attr -D "$3" direct_reg_access "$2" >/dev/null 2>&1
+}
+
+# read_opt: contents of a file, or "" if it is missing/unreadable (like `cat f 2>/dev/null`), in $RF, no fork.
+read_opt () {
+  RF=""
+  if [ -r "$1" ]; then IFS= read -r -d '' RF < "$1" 2>/dev/null; RF=${RF%$'\n'}; fi
+  return 0
+}
+
+# irq_sum PATTERN: sum of the all-digit fields after the first one on the first /proc/interrupts line that
+# contains PATTERN (what `grep PATTERN /proc/interrupts | head -1 | awk ...` computed), in $IRQSUM; "" if none.
+irq_sum () {
+  IRQSUM=""
+  local _l _f _i _s
+  while IFS= read -r _l; do
+    case $_l in
+      *"$1"*)
+        read -ra _f <<< "$_l"; _s=0
+        for (( _i=1; _i<${#_f[@]}; _i++ )); do
+          [[ ${_f[_i]} =~ ^[0-9]+$ ]] && _s=$(( _s + 10#${_f[_i]} ))
+        done
+        IRQSUM=$_s; return 0 ;;
+    esac
+  done < /proc/interrupts
+  return 0
+}
+
+# netdev_rxtx IFACE: fields 2 and 10 of the first /proc/net/dev line containing "IFACE:" in $NDRX / $NDTX.
+netdev_rxtx () {
+  NDRX=""; NDTX=""
+  local _l _f
+  while IFS= read -r _l; do
+    case $_l in
+      *"$1:"*) read -ra _f <<< "$_l"; NDRX=${_f[1]}; NDTX=${_f[9]}; return 0 ;;
+    esac
+  done < /proc/net/dev
+  return 0
+}
