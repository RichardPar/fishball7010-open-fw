 publish () {
   local key="$1" val="$2"
+  # Polling loop only (DUMPING=1): every state/ message is retained, so an unchanged value need not be sent
+  # again. FORCE_REFRESH re-sends everything every few cycles (e.g. after a broker restart). Command handlers
+  # run in another process with DUMPING unset and keep the original always-publish behaviour.
+  if [ "$DUMPING" = 1 ] && [ "$FORCE_REFRESH" != 1 ] && [ "${CACHE[$key]+set}" = set ] && [ "${CACHE[$key]}" = "$val" ]; then
+    return 0
+  fi
   mqtt_publish "$key" "$val"
   if [ "${CACHE[$key]}" != "$val" ]; then
     CACHE[$key]="$val"
     serial_publish "$key" "$val"
+  elif [ "${CACHE[$key]+set}" != set ]; then
+    CACHE[$key]="$val"   # first (empty) value: remember it so the loop path can skip repeats
   fi
 }
 
